# JDA Kimyo sayt API'si — mobil ilova shu manzildan foydalanadi.
#
# Ishlab chiqarish (default, o'zgartirmasa ham ishlaydi):
#   EXPO_PUBLIC_JDA_API_URL=https://jdakimyo.vercel.app
#
# Lokal ishlab chiqishda sayt kompyuterda `npm run dev` bilan ishlaydi.
# DIQQAT: telefon "localhost" ni ko'rmaydi — kompyuterning tarmoqdagi IP'si kerak.
# IP'ni bilish uchun: Windows'da `ipconfig`, mac/Linux'da `ifconfig`.
#
# EXPO_PUBLIC_JDA_API_URL=http://192.168.1.100:3000

EXPO_PUBLIC_JDA_API_URL=https://jdakimyo.vercel.app
