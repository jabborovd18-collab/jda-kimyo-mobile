{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "sinov": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "distribution": "internal",
      "channel": "sinov",
      "env": {
        "EXPO_PUBLIC_JDA_API_URL": "https://www.jdakimyo.uz"
      }
    },
    "ishlab-chiqarish": {
      "autoIncrement": true,
      "channel": "ishlab-chiqarish",
      "env": {
        "EXPO_PUBLIC_JDA_API_URL": "https://www.jdakimyo.uz"
      }
    }
  },
  "submit": {
    "ishlab-chiqarish": {}
  }
}
